# --- Base de données (PostgreSQL) ---
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Auth ---
JWT_SECRET=change-me-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exposé au frontend pour le bouton "Se connecter avec Google"
VITE_GOOGLE_CLIENT_ID=

# --- MKA PMS IA (fournisseurs de modèles) ---
# Au moins un accès texte doit être configuré côté hébergeur. Ne jamais
# exposer ces valeurs au frontend (aucun préfixe VITE_) ni les committer.
OPENAI_API_KEY=
MISTRAL_API_KEY=
# URL d'un endpoint auto-hébergé compatible OpenAI, sans /v1/chat/completions.
# Exemple de forme uniquement : https://modele-interne.example
LOCAL_LLM_URL=

# --- Stripe (Payment Engine) ---
# Ces variables sont AUTO-INJECTÉES par Emergent (onglet "Payments").
# Ne jamais les copier-coller dans un chat ou committer en clair.
# Mode test → aucun débit réel. Mode live → basculement auto après KYC validé.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ACCOUNT_ID=
STRIPE_MODE=test
# Exposé au frontend
VITE_STRIPE_PUBLISHABLE_KEY=

# --- Google Merchant Center (Google Product Engine) ---
# Voir docs/MERCHANT_CENTER_ACTIVATION.md. Sans ces deux variables, le flux
# produit reste préparé (/feeds/produits.xml) mais aucune fiche n'est
# réellement soumise ni son statut relevé — jamais un état supposé.
GOOGLE_MERCHANT_ACCOUNT_ID=
# JSON complet du compte de service, sur une seule ligne. Ne jamais committer.
GOOGLE_MERCHANT_CREDENTIALS=

# --- Application ---
NODE_ENV=production
PORT=8080
PUBLIC_URL=https://www.mkapms.fr
APP_URL=https://www.mkapms.fr
