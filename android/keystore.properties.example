# Modèle — copier en "keystore.properties" (jamais commité, voir .gitignore)
# pour signer un build release en local. Aucune valeur réelle ici.
#
# storeFile   : chemin vers le trousseau .jks/.keystore (clé d'upload Play
#               App Signing, ou clé de signature si Play App Signing n'est
#               pas utilisé) — jamais commis au dépôt.
# storePassword / keyPassword : mots de passe du trousseau et de la clé.
# keyAlias    : alias de la clé dans le trousseau.
#
# Équivalent en variables d'environnement (CI ou signature automatisée),
# lues par android/app/build.gradle si ce fichier n'existe pas :
#   MKAPMS_KEYSTORE_FILE, MKAPMS_KEYSTORE_PASSWORD, MKAPMS_KEY_ALIAS, MKAPMS_KEY_PASSWORD

storeFile=/chemin/absolu/vers/mkapms-release.jks
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME
